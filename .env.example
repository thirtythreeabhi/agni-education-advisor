# Local development uses the existing PostgreSQL 18 cluster on localhost:5432.
DATABASE_URL=postgresql://agni_app:change-me@127.0.0.1:5432/agni_education_advisor
# Staging/production only; do not put this in local DATABASE_URL.
NEON_DATABASE_URL=postgresql://user:password@neon-host/db?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
AGNI_WEBHOOK_HEADER_NAME=x-agni-webhook-secret
AGNI_WEBHOOK_SECRET=replace-with-a-long-random-value
ADMIN_BOOTSTRAP_SECRET=replace-with-a-server-only-bootstrap-secret
BOOTSTRAP_ADMIN_IDENTIFIER=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
# Optional: isolated Neon branch/database used only by integration tests.
TEST_DATABASE_URL=postgresql://test-user:test-password@test-host/test-db?sslmode=require
